# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the shop, no trailing slash. Used for Stripe redirects, sitemap, emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep "true" until products, supplier and company details are real. Blocks live Stripe keys and hides the site from Google.
NEXT_PUBLIC_DEMO_MODE=true

# Stripe: dashboard.stripe.com → Developers → API keys. Use sk_test_ keys while testing.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally, or the webhook endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=

# Resend: resend.com → API keys. Free tier: 3,000 emails/month.
RESEND_API_KEY=
# Sender. Until you verify your own domain in Resend, use onboarding@resend.dev (it can only send to your own Resend account email).
EMAIL_FROM="Northdesk <onboarding@resend.dev>"
# Where new orders, contact messages and withdrawal notices are sent.
ORDER_NOTIFY_EMAIL=
